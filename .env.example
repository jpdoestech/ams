# Vercel project environment variables. Never commit real credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# A publishable key can be used instead of SUPABASE_ANON_KEY.
# The NEXT_PUBLIC aliases supplied by Supabase's Next.js wizard also work here.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
GOOGLE_SHEET_ID=spreadsheet-id-from-google-sheets-url
GOOGLE_SERVICE_ACCOUNT_EMAIL=ams-sync@your-project.iam.gserviceaccount.com
# Paste the service account private_key value, including BEGIN/END lines.
# Both real newlines and literal \n are supported.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
