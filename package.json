  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jpdoestech/ams/issues"
  },
  "homepage": "https://github.com/jpdoestech/ams#readme",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.1"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  }
